{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["server", "scripts", "tests", "drizzle.config.ts", "vitest.config.mts"],
  // The client is typechecked by its own build (bundler resolution); tests/client only runs under vitest.
  "exclude": ["tests/client"]
}
