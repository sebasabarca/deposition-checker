# Your own Anthropic API key, for paid analyses. Read only by the server and worker; never sent to the browser.
# With a key, the app offers Fast and Economy analysis; each run still waits for you to review its estimate, set a
# spending limit and authorize it. Leave it empty to explore the saved demo without any possibility of a charge.
ANTHROPIC_API_KEY=

# Local mode, for one person on their own computer: the API listens on 127.0.0.1 only, any account can authorize
# paid runs (you pay for your own key), and the sign-in page offers "Open the demo workspace" for the account below.
# Demo access works only from this computer and only for an @example.test address. Leave both unset on a server
# other people can reach.
LOCAL_MODE=true
# LOCAL_DEMO_EMAIL="demo@example.test"

# Postgres from docker-compose.yml (start it with `npm run db:up`)
DATABASE_URL="postgres://deposition:deposition@localhost:5432/deposition_checker"
# Separate database for tests; the test suite drops and recreates its tables
TEST_DATABASE_URL="postgres://deposition:deposition@localhost:5432/deposition_checker_test"

# Developer scripts and older single-pair checks: they call Claude only with ALLOW_PAID_CALLS=true set on that one
# command. The app's whole-case analyses (Fast and Economy) don't read it.
# ALLOW_PAID_CALLS=

# Email (verification and password reset) through Resend. Without RESEND_API_KEY in development,
# messages are printed to the server console instead of sent; in production they're required.
# EMAIL_FROM must be an address on a domain you've verified in Resend. APP_URL is where links point.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Veridict <no-reply@your-verified-domain>"
APP_URL="http://localhost:5173"

# Production behind HTTPS: send the session cookie only over HTTPS, and trust one proxy hop for
# the client's address and protocol.
# COOKIE_SECURE=true
# TRUST_PROXY=1
# PORT=3001
# Production compose (compose.prod.yml) also needs a database password:
# POSTGRES_PASSWORD="a long random password"

# Whole-case runs (jobs/limiter.ts): packets in flight per run and in all, runs at once per worker, and the
# provider's limits for the packet model (set them to the account's tier: Console, Rate limits). Conservative defaults.
# The limits apply per worker process: with two workers, give each half. Output is admitted at each request's
# max_tokens (44,000 for an 8-pair packet), so the output limit also caps how many packets run at once.
# CASE_RUN_PACKETS_PER_CASE=2
# CASE_RUN_PACKETS_GLOBAL=4
# CASE_RUN_MAX_CASES=2
# PROVIDER_REQUESTS_PER_MINUTE=50
# PROVIDER_INPUT_TOKENS_PER_MINUTE=200000
# PROVIDER_OUTPUT_TOKENS_PER_MINUTE=200000
# PROVIDER_BURST_SECONDS=10
# Economy analysis in the app needs only ANTHROPIC_API_KEY. scripts/case-run.ts --live --economy also needs
# ALLOW_ECONOMY_ANALYSIS=true on that command.
# Experimental whole-stretch reading (stretch-v2, docs/whole-stretch-v2.md): offered on start only when "true".
# Off by default; packet-v1 stays the default contract. Not validated for accuracy.
ALLOW_STRETCH_V2=
# Economy (Message Batches API) case runs: requests per batch (at most 100000), batches open at once, seconds
# between checks of open batches, and the largest batch body in MB (the provider's limit is 256).
# CASE_RUN_BATCH_SIZE=100
# CASE_RUN_BATCHES_IN_FLIGHT=10
# CASE_RUN_BATCH_POLL_SECONDS=60
# CASE_RUN_BATCH_MAX_MB=32

# Test-model case runs over the API (a developer tool; the UI never offers them). Off unless "true".
ALLOW_TEST_RUNS=
