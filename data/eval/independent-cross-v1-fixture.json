oader":"text","session":"B02_witness1","part":1},"B02_witness2":{"sha256":"2a653a22de194d2d473fae6bbf7c37d6dfda44954bdc2ee7a4faf281619f864a","witness":"Marco Tellez","takenOn":"2025-12-02","scheme":"file_line","local":"data/eval/independent-cross-v1/transcripts/B02_witness2.txt","loader":"text","session":"B02_witness2","part":1},"B03_witness1":{"sha256":"6f67ae2adf8c1b011351c1c0329c7ebfdc524ed7ff2710e7fdcf74be1c77dbf6","witness":"Owen Castellano","takenOn":"2026-08-19","scheme":"page_line","local":"data/eval/independent-cross-v1/transcripts/B03_witness1.txt","loader":"text","session":"B03_witness1","part":1},"B03_witness2":{"sha256":"96cfbdda61f64b5fc09cd38ec7800e9c3ca8b7cc30b64e390fa00ae92e6231c4","witness":"Rosalind Achterberg","takenOn":"2026-09-02","scheme":"page_line","local":"data/eval/independent-cross-v1/transcripts/B03_witness2.txt","loader":"text","session":"B03_witness2","part":1},"B04_witness1":{"sha256":"4a91c0d622896103114eb607c94d098306a3f81bfb013727a3529d5192043d9c","witness":"Darren Holloway","takenOn":"2026-02-11","scheme":"page_line","local":"data/eval/independent-cross-v1/transcripts/B04_witness1.txt","loader":"text","session":"B04_witness1","part":1},"B04_witness2":{"sha256":"0779c1ba2cda940787b5c48cbc26a5c3e2ad6baf8155cb7a0721496f16339b14","witness":"Grace Obuya","takenOn":"2026-02-25","scheme":"page_line","local":"data/eval/independent-cross-v1/transcripts/B04_witness2.txt","loader":"text","session":"B04_witness2","part":1},"B05_witness1":{"sha256":"83c97c0e4b4845e4f089878816e625bba0d1533bccdcd4188f4913cb204e0193","witness":"Teresa Vukovic","takenOn":"2026-09-15","scheme":"file_line","local":"data/eval/independent-cross-v1/transcripts/B05_witness1.txt","loader":"text","session":"B05_witness1","part":1},"B05_witness2":{"sha256":"57894b3f906284932b938cf7de1eb131c249b3007e61cdf3a2ca0113807878ee","witness":"Samuel Prentiss","takenOn":"2026-09-29","scheme":"page_line","local":"data/eval/independent-cross-v1/transcripts/B05_witness2.txt","loader":"text","session":"B05_witness2","part":1}},"items":[{"id":"A01-S1","category":"conflict","label":"independent-cross-v1#A01-S1","sides":[{"document":"A01_witness1","from":"3:8","to":"3:9","search":"The backup alarm was beeping the whole time I was reversing."},{"document":"A01_witness2","from":"2:19","to":"2:20","search":"When he reversed out of the bay there was no alarm. I didn't hear a single beep"}]},{"id":"A01-S2","category":"conflict","label":"independent-cross-v1#A01-S2","sides":[{"document":"A01_witness1","from":"2:10","to":"2:11","search":"No. Nobody said a word about aisle 14 at that huddle."},{"document":"A01_witness2","from":"1:21","to":"1:24","search":"I said aisle 14 was closed to all forklift traffic because the order pickers were restocking it by hand. I said it to the whole group, and I said it to Ray directly, by name"}]},{"id":"A01-R1","category":"no_conflict","label":"independent-cross-v1#A01-R1","sides":[{"document":"A01_witness1","from":"3:25","to":"4:1","search":"Soft. Pedal went most of the way to the floor before it grabbed."},{"document":"A01_witness2","from":"3:8","to":"3:9","search":"Unit 22 passed its pre-shift inspection. The brakes were checked and marked satisfactory."}]},{"id":"A01-N1","category":"no_conflict","label":"independent-cross-v1#A01-N1","sides":[{"document":"A01_witness1","from":"2:19","to":"2:19","search":"I had a spotter that day. Luis Ferro."},{"document":"A01_witness2","from":"2:8","to":"2:10","search":"As far as I know, no spotter was assigned to him. But I didn't make the assignments, Dana did, and I didn't see her sheet that day."}]},{"id":"A01-N2","category":"no_conflict","label":"independent-cross-v1#A01-N2","sides":[{"document":"A01_witness1","from":"4:20","to":"4:21","search":"On the 14th the yellow walkway lines in that aisle were faded. You could barely see them."},{"document":"A01_witness2","from":"4:2","to":"4:4","search":"The walkway lines in aisle 14 are bright yellow. They were repainted in April 2025, along with the rest of that zone."}]},{"id":"B01-S1","category":"conflict","label":"independent-cross-v1#B01-S1","sides":[{"document":"B01_witness1","from":"6:8","to":"6:9","search":"There was no signal on the cab or the trailer when it came over."},{"document":"B01_witness2","from":"2:20","to":"2:20","search":"Left blinker was on before I moved over"}]},{"id":"B01-S2","category":"conflict","label":"independent-cross-v1#B01-S2","sides":[{"document":"B01_witness1","from":"6:22","to":"6:22","search":"The pavement was dry when the truck hit me."},{"document":"B01_witness2","from":"3:7","to":"3:7","search":"It was coming down pretty good right when it happened."}]},{"id":"B01-N1","category":"no_conflict","label":"independent-cross-v1#B01-N1","sides":[{"document":"B01_witness1","from":"7:20","to":"7:20","search":"The man driving the pickup was the one who put out flares."},{"document":"B01_witness2","from":"3:15","to":"3:16","search":"I put the triangles out. That was me."}]},{"id":"B01-N2","category":"no_conflict","label":"independent-cross-v1#B01-N2","sides":[{"document":"B01_witness1","from":"5:13","to":"5:13","search":"The pickup was in the left lane, a little ahead of me."},{"document":"B01_witness2","from":"3:24","to":"3:24","search":"I don't recall which lane the pickup was in before all this."}]},{"id":"A02-S1","category":"conflict","label":"independent-cross-v1#A02-S1","sides":[{"document":"A02_witness1","from":"2:14","to":"2:16","search":"I called before I gave it, at about 9:30, and I spoke to Dr. Sethi himself, and he told me the dose was fine."},{"document":"A02_witness2","from":"0:36","to":"0:38","search":"Ms. Morrow did not call me that night. I received no call from 4 West about Mrs. Pettibone's insulin, before or after the dose."}]},{"id":"A02-S2","category":"conflict","label":"independent-cross-v1#A02-S2","sides":[{"document":"A02_witness1","from":"2:28","to":"3:2","search":"The vial I pulled from her pocket was the U-500, the concentrated one, with the striped label. That's the only thing that was in there."},{"document":"A02_witness2","from":"0:47","to":"0:49","search":"Her pocket in the refrigerated drawer on 4 West contained only U-100 vials that night. Regular insulin, U-100. There was no U-500 in her pocket."}]},{"id":"A02-R1","category":"no_conflict","label":"independent-cross-v1#A02-R1","sides":[{"document":"A02_witness1","from":"2:10","to":"2:10","search":"The order on the screen said forty units."},{"document":"A02_witness2","from":"0:26","to":"0:26","search":"The order I verified read four units."}]},{"id":"A02-N1","category":"no_conflict","label":"independent-cross-v1#A02-N1","sides":[{"document":"A02_witness1","from":"2:3","to":"2:3","search":"I gave it at 9:52."},{"document":"A02_witness2","from":"0:71","to":"0:72","search":"I was told by the night house supervisor that the dose went in just before ten."}]},{"id":"A02-N2","category":"no_conflict","label":"independent-cross-v1#A02-N2","sides":[{"document":"A02_witness1","from":"1:26","to":"1:27","search":"I pulled insulin for her four times"},{"document":"A02_witness2","from":"0:61","to":"0:64","search":"The system logged six insulin withdrawals for her from that cabinet during the night shift. Two of the six were cancelled transactions, where the drawer opened and the nurse cancelled without"}]},{"id":"B02-S1","category":"conflict","label":"independent-cross-v1#B02-S1","sides":[{"document":"B02_witness1","from":"7:11","to":"7:12","search":"At six-thirty the dial inside the walk-in door read 38 degrees."},{"document":"B02_witness2","from":"0:50","to":"0:50","search":"Fifty-one. The dial said fifty-one."}]},{"id":"B02-S2","category":"conflict","label":"independent-cross-v1#B02-S2","sides":[{"document":"B02_witness1","from":"6:25","to":"6:25","search":"Marco Tellez made it."},{"document":"B02_witness2","from":"0:28","to":"0:28","search":"I didn't touch the chicken salad Thursday."}]},{"id":"B02-R1","category":"conflict_needs_context","label":"independent-cross-v1#B02-R1","sides":[{"document":"B02_witness1","from":"8:4","to":"8:4","search":"The sanitizer tested at two hundred parts per million."},{"document":"B02_witness2","from":"0:60","to":"0:60","search":"The strips barely changed color. Like it was water."}]},{"id":"B02-N1","category":"no_conflict","label":"independent-cross-v1#B02-N1","sides":[{"document":"B02_witness1","from":"8:20","to":"8:20","search":"The county's report listed four violations."},{"document":"B02_witness2","from":"0:79","to":"0:79","search":"The one I saw had two violations."}]},{"id":"B02-N2","category":"no_conflict","label":"independent-cross-v1#B02-N2","sides":[{"document":"B02_witness1","from":"8:14","to":"8:14","search":"Thirty-one in total."},{"document":"B02_witness2","from":"0:71","to":"0:71","search":"Twenty-four. That's what Priya said Friday night."}]},{"id":"A03-S1","category":"conflict","label":"independent-cross-v1#A03-S1","sides":[{"document":"A03_witness1","from":"2:3","to":"2:4","search":"I handed the June 3 letter to Peter in person, at the management office, on June 3."},{"document":"A03_witness2","from":"1:24","to":"2:1","search":"Ms. Vantongeren did not hand me anything on June 3. I was not in the office that day. I was in Tucson the entire week of June 3"}]},{"id":"A03-S2","category":"conflict","label":"independent-cross-v1#A03-S2","sides":[{"document":"A03_witness1","from":"3:3","to":"3:5","search":"On the walkthrough on July 18 water was coming through the ceiling tiles over the proofing area, we had buckets out, three buckets"},{"document":"A03_witness2","from":"2:24","to":"2:25","search":"During the July 18 walkthrough the ceiling over the proofing area was dry. No buckets, no drips."}]},{"id":"A03-R1","category":"conflict_needs_context","label":"independent-cross-v1#A03-R1","sides":[{"document":"A03_witness1","from":"3:14","to":"3:15","search":"The lease says the landlord is responsible for the roof."},{"document":"A03_witness2","from":"2:14","to":"2:15","search":"The lease makes the tenant responsible for roof repairs."}]},{"id":"A03-N1","category":"no_conflict","label":"independent-cross-v1#A03-N1","sides":[{"document":"A03_witness1","from":"2:16","to":"2:17","search":"Peter never approved the roof repair."},{"document":"A03_witness2","from":"1:13","to":"1:14","search":"I have authority to approve any repair under $5,000 without the owner's approval."}]},{"id":"A03-N2","category":"no_conflict","label":"independent-cross-v1#A03-N2","sides":[{"document":"A03_witness1","from":"4:4","to":"4:5","search":"My copy of the ledger shows the August rent paid on August 6."},{"document":"A03_witness2","from":"3:11","to":"3:11","search":"The ledger shows August rent unpaid."}]},{"id":"B03-S1","category":"conflict","label":"independent-cross-v1#B03-S1","sides":[{"document":"B03_witness1","from":"4:12","to":"4:12","search":"It was green. The tag on Bay C was green at seven."},{"document":"B03_witness2","from":"6:17","to":"6:17","search":"Red. Bay C carried a red tag at seven a.m. on the twelfth."}]},{"id":"B03-S2","category":"conflict","label":"independent-cross-v1#B03-S2","sides":[{"document":"B03_witness1","from":"4:20","to":"4:21","search":"it had a two-by-ten pad under it."},{"document":"B03_witness2","from":"6:22","to":"6:22","search":"No mudsill. No timber of any kind under that leg."}]},{"id":"B03-R1","category":"no_conflict","label":"independent-cross-v1#B03-R1","sides":[{"document":"B03_witness1","from":"5:21","to":"5:22","search":"It was gusting pretty hard, I'd guess thirty, thirty-five."},{"document":"B03_witness2","from":"8:3","to":"8:3","search":"The anemometer read twelve miles an hour, gusts to fifteen."}]},{"id":"B03-N1","category":"no_conflict","label":"independent-cross-v1#B03-N1","sides":[{"document":"B03_witness1","from":"5:15","to":"5:16","search":"Yes, I had the authority to shut down any scaffold on that site."},{"document":"B03_witness2","from":"7:11","to":"7:11","search":"Owen didn't shut down Bay C. Nobody from Brightline did."}]},{"id":"B03-N2","category":"no_conflict","label":"independent-cross-v1#B03-N2","sides":[{"document":"B03_witness1","from":"5:7","to":"5:8","search":"Three. There were three masons on the Bay C platform when it went."},{"document":"B03_witness2","from":"7:17","to":"7:18","search":"As far as I knew, nobody was supposed to be on Bay C that day."}]},{"id":"A04-S2","category":"conflict","label":"independent-cross-v1#A04-S2","sides":[{"document":"A04_witness1","from":"0:51","to":"0:53","search":"At the acceptance test on November 12 the route optimizer crashed every time we loaded more than fifty stops. Every time. We ran the 200-stop scenario three times. It crashed three times."},{"document":"A04_witness2","from":"2:18","to":"2:20","search":"On November 12 the route optimizer ran every test scenario, including the 200-stop scenario, without a crash."}]},{"id":"A04-R1","category":"conflict_needs_context","label":"independent-cross-v1#A04-R1","sides":[{"document":"A04_witness1","from":"0:74","to":"0:75","search":"In December, in production, the dispatch screen took over thirty seconds to load."},{"document":"A04_witness2","from":"3:16","to":"3:17","search":"In my experience the dispatch screen loaded in under two seconds."}]},{"id":"A04-N1","category":"no_conflict","label":"independent-cross-v1#A04-N1","sides":[{"document":"A04_witness1","from":"0:66","to":"0:67","search":"The CSV export never worked for us. We'd click export and get an error."},{"document":"A04_witness2","from":"3:10","to":"3:12","search":"Yes. The CSV export works. I demonstrated it myself in January, on version 2.0.1, on our demo server."}]},{"id":"A04-N2","category":"no_conflict","label":"independent-cross-v1#A04-N2","sides":[{"document":"A04_witness1","from":"0:62","to":"0:62","search":"I signed change order 4 for the mobile app on August 9."},{"document":"A04_witness2","from":"3:6","to":"3:7","search":"I don't recall whether Ms. Okafor signed the change order for the mobile app."}]},{"id":"B04-S1","category":"conflict","label":"independent-cross-v1#B04-S1","sides":[{"document":"B04_witness1","from":"2:21","to":"2:21","search":"I was not at that meeting."},{"document":"B04_witness2","from":"4:20","to":"4:20","search":"Darren Holloway was there."}]},{"id":"B04-S2","category":"conflict","label":"independent-cross-v1#B04-S2","sides":[{"document":"B04_witness1","from":"2:4","to":"2:5","search":"I handed him the written plan"},{"document":"B04_witness2","from":"4:5","to":"4:5","search":"Nobody handed Kenji anything in that meeting."}]},{"id":"B04-R1","category":"conflict_needs_context","label":"independent-cross-v1#B04-R1","sides":[{"document":"B04_witness1","from":"3:9","to":"3:10","search":"SOP-114 required two signatures on every load record."},{"document":"B04_witness2","from":"5:2","to":"5:3","search":"One signature. The procedure only needed the operator's signature."}]},{"id":"B04-N1","category":"no_conflict","label":"independent-cross-v1#B04-N1","sides":[{"document":"B04_witness1","from":"3:22","to":"3:22","search":"As of September 30 his badge was active."},{"document":"B04_witness2","from":"5:18","to":"5:19","search":"His badge didn't work at the front door that morning."}]},{"id":"B04-N2","category":"no_conflict","label":"independent-cross-v1#B04-N2","sides":[{"document":"B04_witness1","from":"4:7","to":"4:7","search":"It gave him twenty-one days to consider it"},{"document":"B04_witness2","from":"5:26","to":"5:27","search":"he got a severance paper and had three weeks to think about it."}]},{"id":"A05-S1","category":"conflict","label":"independent-cross-v1#A05-S1","sides":[{"document":"A05_witness1","from":"2:20","to":"2:22","search":"She looked right at the pry marks on the back door frame. She took pictures of them. There were gouges right next to the strike plate"},{"document":"A05_witness2","from":"2:6","to":"2:8","search":"When I inspected the back door on February 21 there were no pry marks on the frame or on the strike plate."}]},{"id":"A05-S2","category":"conflict","label":"independent-cross-v1#A05-S2","sides":[{"document":"A05_witness1","from":"3:1","to":"3:2","search":"I told her the alarm was not on that night, I'd forgotten to set it. I never said it was set."},{"document":"A05_witness2","from":"2:16","to":"2:18","search":"During the February 21 inspection Mr. Lindqvist told me the alarm was armed when he left the house that evening."}]},{"id":"A05-R1","category":"no_conflict","label":"independent-cross-v1#A05-R1","sides":[{"document":"A05_witness1","from":"3:9","to":"3:10","search":"The watch was worth about eleven thousand dollars."},{"document":"A05_witness2","from":"3:14","to":"3:15","search":"The claim listed the watch at four thousand two hundred dollars."}]},{"id":"A05-N1","category":"no_conflict","label":"independent-cross-v1#A05-N1","sides":[{"document":"A05_witness1","from":"1:21","to":"1:22","search":"I called 911 myself as soon as I walked in, about 11:40"},{"document":"A05_witness2","from":"3:2","to":"3:4","search":"The first 911 call about the house came from a neighbor, Mrs. Odell, at 11:25 p.m., reporting a man in the backyard."}]},{"id":"A05-N2","category":"no_conflict","label":"independent-cross-v1#A05-N2","sides":[{"document":"A05_witness1","from":"3:5","to":"3:5","search":"They took nineteen things."},{"document":"A05_witness2","from":"3:10","to":"3:12","search":"The inventory lists twenty-two line items. Three of those were entered twice on the form, so it is nineteen distinct items."}]},{"id":"B05-S1","category":"conflict","label":"independent-cross-v1#B05-S1","sides":[{"document":"B05_witness1","from":"0:51","to":"0:51","search":"Nobody from the bank called me that day."},{"document":"B05_witness2","from":"6:12","to":"6:13","search":"I placed the callback to Ms. Vukovic at 10:52 a.m. on April 17."}]},{"id":"B05-S2","category":"conflict","label":"independent-cross-v1#B05-S2","sides":[{"document":"B05_witness1","from":"0:26","to":"0:27","search":"As of April 17, our account required two approvers for any wire."},{"document":"B05_witness2","from":"5:4","to":"5:5","search":"As of April 17, Harrowgate's profile was set to single approval."}]},{"id":"B05-R1","category":"no_conflict","label":"independent-cross-v1#B05-R1","sides":[{"document":"B05_witness1","from":"0:31","to":"0:31","search":"Our wire limit was two hundred fifty thousand."},{"document":"B05_witness2","from":"5:12","to":"5:12","search":"The limit was five hundred thousand."}]},{"id":"B05-N1","category":"no_conflict","label":"independent-cross-v1#B05-N1","sides":[{"document":"B05_witness1","from":"0:47","to":"0:47","search":"When I looked at the portal, there was no wire pending."},{"document":"B05_witness2","from":"6:2","to":"6:3","search":"At 10:45 the wire was sitting in pending status"}]},{"id":"B05-N2","category":"no_conflict","label":"independent-cross-v1#B05-N2","sides":[{"document":"B05_witness1","from":"0:67","to":"0:67","search":"I reported it to the bank the next business day."},{"document":"B05_witness2","from":"7:5","to":"7:5","search":"The fraud claim was opened on Monday, April 20"}]}],"unresolved":[]}